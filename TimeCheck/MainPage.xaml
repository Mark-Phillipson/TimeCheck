<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TimeCheck"
             xmlns:shared="clr-namespace:TimeCheck.Shared;assembly=TimeCheck.Shared"
             x:Class="TimeCheck.MainPage"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <!-- <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type shared:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView> -->
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <Label x:Name="HelpLabel"
               Grid.Row="0"
               Text="Say 'what is the time'"
               FontSize="15"
               LineBreakMode="WordWrap"
               MaxLines="2"
               HorizontalOptions="Center"
               Margin="10,8,10,2" />
               
        <Label x:Name="TimeLabel"
               Grid.Row="1"
               Text="00:00"
               FontSize="96"
               VerticalTextAlignment="Center"
               HorizontalTextAlignment="Center"
               Margin="10,0"/>
               
        <!-- Mode Toggle Buttons -->
        <Grid Grid.Row="2" Margin="10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="TimeCheckModeButton"
                    Grid.Column="0"
                    Text="Time Check Mode"
                    FontSize="18"
                    Margin="0,0,5,0"
                    BackgroundColor="LightGreen"
                    Clicked="TimeCheckModeButton_Clicked"/>
                <Button x:Name="EncouragementModeButton"
                    Grid.Column="1"
                    Text="Beast Me"
                    FontSize="18"
                    Margin="5,0,0,0"
                    BackgroundColor="LightGray"
                    Clicked="EncouragementModeButton_Clicked"/>
        </Grid>
        
        <!-- Current Mode Label -->
        <Label x:Name="CurrentModeLabel"
               Grid.Row="3"
               Text="Current Mode: Time Check (announces time every 5 minutes)"
               FontSize="13"
               HorizontalOptions="Center"
               Margin="10,2,10,4"
               TextColor="Gray"/>
        
        <!-- Quiet mode toggle -->
        <Grid Grid.Row="4" Margin="10,4">
            <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Text="Quiet mode" Grid.Column="0" VerticalOptions="Center" />
            <Switch x:Name="QuietModeSwitch" Grid.Column="1" Toggled="QuietModeSwitch_Toggled" />
        </Grid>

        <Button x:Name="StartListeningButton"
            Grid.Row="5"
                Text="Speak Time"
                FontSize="24"
                Margin="10,4"
                Clicked="StartListeningButton_Clicked"/>
                
        <Button x:Name="MinimizeAppButton"
            Grid.Row="6"
                Text="Minimize App"
                FontSize="24"
                Margin="10,4"
                Clicked="MinimizeAppButton_Clicked"/>
                
        <Button x:Name="CloseAppButton"
            Grid.Row="7"
                Text="Close App"
                FontSize="24"
                Margin="10,4"
                Clicked="CloseAppButton_Clicked"/>

        <!-- Companion Settings Panel (collapsible) -->
        <StackLayout Grid.Row="8" Margin="20,10,20,10" Spacing="0" BackgroundColor="#f0f0f0">

            <!-- Header / toggle row -->
            <Grid BackgroundColor="#2b0b98" Padding="10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0"
                       Text="Companion Assistant"
                       FontAttributes="Bold"
                       FontSize="16"
                       TextColor="White"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        x:Name="ToggleSettingsButton"
                        Text="▲ Hide"
                        FontSize="13"
                        Padding="8,4"
                        HeightRequest="34"
                        BackgroundColor="#512bdf"
                        TextColor="White"
                        Clicked="ToggleSettings_Clicked" />
            </Grid>

            <!-- Collapsible body -->
            <StackLayout x:Name="CompanionSettingsBody" Padding="10" Spacing="8">
                <Entry x:Name="AssistantUrlEntry" Placeholder="Assistant Base URL (http://192.168.0.100:5000)" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Entry x:Name="DeviceTokenEntry" Placeholder="Device Token" IsPassword="True" />
                    <Button x:Name="ToggleDeviceTokenButton" Grid.Column="1" Text="Show" Clicked="ToggleDeviceToken_Clicked" Padding="8,4" HeightRequest="34" />
                </Grid>
                <Entry x:Name="DeviceNameEntry" Placeholder="Device Name (optional)" />
                <Button Text="Save Companion Settings" Clicked="SaveCompanionSettings_Clicked" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Label Text="Reduce system listening interference" Grid.Column="0" VerticalOptions="Center" />
                    <Switch x:Name="InterferenceReductionSwitch" Grid.Column="1" Toggled="InterferenceReductionSwitch_Toggled" />
                </Grid>
                <Button x:Name="SyncLaunchesButton" Text="Sync Launches (from Companion)" Clicked="SyncLaunchesButton_Clicked" />
                <Button x:Name="SendTestCommandButton" Text="Speak Local Command" Clicked="SendTestCommand_Clicked" IsEnabled="False" />
                <Button x:Name="SpeakCompanionButton" Text="Speak Companion Command" Clicked="SpeakCompanionCommand_Clicked" IsEnabled="False" />
                <Button x:Name="ToggleCompanionServiceButton" Text="Start Companion Service" Clicked="ToggleCompanionService_Clicked" />
                <Label x:Name="AssistantStatusLabel" Text="Companion status" FontSize="12" TextColor="Gray" />
            </StackLayout>

        </StackLayout>
    </Grid>

</ContentPage>
