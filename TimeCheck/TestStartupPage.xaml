<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TimeCheck.TestStartupPage"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <VerticalStackLayout Padding="20" Spacing="18" HorizontalOptions="Center" VerticalOptions="Center">
        <Label Text="Test Startup Page" FontSize="24" HorizontalOptions="Center" />
        <Label x:Name="PlatformLabel" FontSize="14" HorizontalOptions="Center" />
        <Label x:Name="TimeLabel" FontSize="18" HorizontalOptions="Center" />
        <Label Text="This minimal page isolates navigation/Shell fragments so the app can start." FontSize="12" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
    </VerticalStackLayout>

</ContentPage>
